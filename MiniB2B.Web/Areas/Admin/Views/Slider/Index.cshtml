@model IEnumerable<MiniB2B.Entities.Slider>
@{
    ViewData["Title"] = "Slider Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Slider Yönetimi</h2>
        <p class="text-muted">Görselleri sürükleyip bırakarak ana sayfadaki gösterim sırasını ayarlayabilirsiniz.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Yeni Slider Ekle</a>
</div>

<div class="row" id="sliderList">
    @foreach (var item in Model)
    {
        <div class="col-md-4 col-sm-6 mb-4 slider-item" data-id="@item.Id">
            <div class="card h-100 shadow-sm border-0 position-relative">
                <!-- Drag Handle -->
                <div class="position-absolute top-0 start-0 m-2 p-1 bg-white rounded shadow-sm" style="cursor: grab; z-index: 10;">
                    <i class="bi bi-grip-vertical text-muted fs-5"></i>
                </div>
                
                <!-- Status Badge -->
                <div class="position-absolute top-0 end-0 m-2" style="z-index: 10;">
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success shadow-sm" data-bs-toggle="tooltip" title="Ana sayfada gösteriliyor"><i class="bi bi-eye"></i> Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-danger shadow-sm" data-bs-toggle="tooltip" title="Ana sayfada gizli"><i class="bi bi-eye-slash"></i> Pasif</span>
                    }
                </div>

                <div style="height: 200px; overflow: hidden; display: flex; align-items: center; justify-content: center; background-color: #f8f9fa;">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
                
                <div class="card-body">
                    <h5 class="card-title text-truncate" data-bs-toggle="tooltip" title="@item.Title">
                        @(string.IsNullOrEmpty(item.Title) ? "Başlıksız" : item.Title)
                    </h5>
                    <p class="card-text text-muted small text-truncate" style="height: 40px;" data-bs-toggle="tooltip" title="@item.Description">
                        @(string.IsNullOrEmpty(item.Description) ? "Açıklama yok" : item.Description)
                    </p>
                    
                    @if (!string.IsNullOrEmpty(item.LinkUrl))
                    {
                        <p class="card-text small mb-1 text-truncate" data-bs-toggle="tooltip" title="@item.LinkUrl">
                            <i class="bi bi-link-45deg"></i> <a href="@item.LinkUrl" target="_blank" class="text-decoration-none">Yönlendirme Linki</a>
                        </p>
                    }
                    else
                    {
                        <p class="card-text small mb-1 text-muted"><i class="bi bi-link-45deg"></i> Link Yok</p>
                    }
                </div>
                <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning w-50 me-1">
                        <i class="bi bi-pencil"></i> Düzenle
                    </a>
                    <button class="btn btn-sm btn-outline-danger w-50 ms-1" onclick="deleteSlider(@item.Id)">
                        <i class="bi bi-trash"></i> Sil
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5 border rounded bg-light">
        <i class="bi bi-image fs-1 d-block mb-3"></i>
        <h5>Henüz slider eklenmemiş.</h5>
        <p>Sağ üstteki butonu kullanarak ilk slider görselinizi ekleyin.</p>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });

            var el = document.getElementById('sliderList');
            if (el) {
                var sortable = Sortable.create(el, {
                    animation: 150,
                    handle: '.card',
                    ghostClass: 'bg-light',
                    onEnd: function () {
                        var newOrder = [];
                        $('#sliderList .slider-item').each(function () {
                            newOrder.push($(this).data('id'));
                        });

                        $.ajax({
                            url: '/Admin/Slider/UpdateOrder',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(newOrder),
                            success: function (res) {
                                if (res.success) {
                                    console.log('Sıralama başarıyla güncellendi.');
                                }
                            }
                        });
                    }
                });
            }
        });

        function deleteSlider(id) {
            if (confirm('Bu slider içeriğini silmek istediğinize emin misiniz?')) {
                $.post('/Admin/Slider/Delete/' + id, function(res) {
                    if (res.success) {
                        $('.slider-item[data-id="' + id + '"]').fadeOut(function() { $(this).remove(); });
                    } else {
                        alert(res.message);
                    }
                });
            }
        }
    </script>
}
