@model List<MiniB2B.Entities.Order>
@{
    ViewData["Title"] = "Sipariş Yönetimi";
    Layout = "_AdminLayout";
}

<h2>Tüm Siparişler</h2>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Sipariş Id</th>
            <th>Sipariş No</th>
            <th>Kullanıcı Id</th>
            <th>Kullanıcı</th>
            <th>Tarih</th>
            <th>Tutar</th>
            <th>Durum</th>
            <th>İşlem</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.OrderNumber</td>
                <td>@order.UserId</td>
                <td>@order.User.FirstName @order.User.LastName</td>
                <td>@order.OrderDate.ToString("g")</td>
                <td>@order.TotalAmount.ToString("C2")</td>
                <td>
                    <span class="badge @(order.Status == MiniB2B.Entities.OrderStatus.Beklemede ? "bg-warning text-dark" : order.Status == MiniB2B.Entities.OrderStatus.Onaylandi ? "bg-success" : "bg-danger")">
                        @order.Status
                    </span>
                </td>
                <td>
                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@order.Id" />
                        <select name="status" class="form-select form-select-sm d-inline w-auto">
                            @foreach (var status in Enum.GetValues(typeof(MiniB2B.Entities.OrderStatus)))
                            {
                                if (order.Status.Equals(status))
                                {
                                    <option value="@status" selected>@status</option>
                                }
                                else
                                {
                                    <option value="@status">@status</option>
                                }
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary">Güncelle</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
