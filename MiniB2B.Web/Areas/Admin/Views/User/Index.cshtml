@model IEnumerable<MiniB2B.Entities.User>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Kullanıcılar</h2>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-striped">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>Kullanıcı Adı</th>
                    <th>E-posta</th>
                    <th>Rol</th>
                    <th>Kayıt Tarihi</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model)
                {
                    <tr>
                        <td>@item.FirstName @item.LastName</td>
                        <td>@item.Username</td>
                        <td>@item.Email</td>
                        <td>
                            @if(item.Role == "Admin") { <span class="badge bg-danger">Admin</span> }
                            else { <span class="badge bg-secondary">Müşteri</span> }
                        </td>
                        <td>@item.CreatedAt.ToShortDateString()</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
