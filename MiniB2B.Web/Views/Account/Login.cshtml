@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h4 class="card-title text-center mb-4">MiniB2B Portal</h4>
                
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Kullanıcı Adı</label>
                        <input asp-for="Username" class="form-control" required />
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Şifre</label>
                        <input asp-for="Password" type="password" class="form-control" required />
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
                </form>
                
                <div class="mt-3 text-muted small text-center">
                    <p>Demo Admin: admin / 123456</p>
                    <p>Demo Customer: customer / 123456</p>
                    <p><a asp-action="Register">Hesabın yok mu? Kayıt Ol</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
