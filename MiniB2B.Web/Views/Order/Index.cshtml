@model List<MiniB2B.Entities.SiparisR>
@{
    ViewData["Title"] = "Siparişlerim";
}

<h2>Siparişlerim</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Henüz siparişiniz bulunmamaktadır.</div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Sipariş No</th>
                <th>Tarih</th>
                <th>Tutar</th>
                <th>Durum</th>
                <th>Detay</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderNumber</td>
                    <td>@order.OrderDate.ToString("g")</td>
                    <td>@order.TotalAmount.ToString("C2")</td>
                    <td>
                        @if (order.Status == MiniB2B.Entities.OrderStatus.Beklemede)
                        {
                            <span class="badge bg-warning text-dark">Beklemede</span>
                        }
                        else if (order.Status == MiniB2B.Entities.OrderStatus.Onaylandi)
                        {
                            <span class="badge bg-success">Onaylandı</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Reddedildi</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-info text-white">İncele</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
